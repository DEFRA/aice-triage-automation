# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Which scoring engine to use: `stub` (offline, no network, no cost) or
# `bedrock` (calls a real hosted AI model). Defaults to `stub`.
SCORING_ENGINE=stub

# The AWS region to call Amazon Bedrock in. eu-west-2 is London.
BEDROCK_REGION=

# Bedrock identifiers for each call. On CDP these should normally be inference
# profile IDs or ARNs. A bare model ID is still legal for local experiments.
# The scorer is Claude Sonnet 4.6: `anthropic.claude-sonnet-4-6`. Use the bare
# ID — the `eu.` and `global.` prefixes route outside the UK and are denied by
# the organisation service control policy.
BEDROCK_SCORE_MODEL_ID=
BEDROCK_CLASSIFY_MODEL_ID=

# Optional Bedrock guardrail configuration. Leave empty to disable locally.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# The Amazon Bedrock API key (a bearer token). This is a SECRET, and it is
# LOCAL ONLY. It is not declared in src/config.js — the AWS SDK reads it
# straight from the environment at runtime.
#
# Deployed environments do not use it. On CDP the container's task role supplies
# the credentials, so this variable should be set on laptops and nowhere else.
# If you find it in a CDP secret, that is a finding, not a fix.
AWS_BEARER_TOKEN_BEDROCK=

# A local, git-ignored directory of example triage submissions.
SUBMISSIONS_DIR=
